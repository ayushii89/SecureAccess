{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "SecureAccess",
    "Audience": "SecureAccess.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "LoginPermitLimit": 20,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 30,
    "RegisterWindowSeconds": 60,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
